{
  "$schema": "https://opencode.ai/config.json",
  "model": "qwen3.8-flash-next-iq3_s",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Strata (AIBOX)",
      "options": {
        "baseURL": "http://192.168.2.84:8080/v1",
        "apiKey": "<your-api-key>"
      },
      "models": {
          "qwen3.8-flash-next-iq3_s": { "name": "qwen 3.8 flash" },
      }
    }
  },
  "plugins": [
    {
      "package": "./",
      "options": {
        "apiUrl": "https://example.com/webhook",
        "apiOn": true,
        "labels": ["my-label"]
      }
    }
  ]
}
